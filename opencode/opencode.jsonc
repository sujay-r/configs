{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "mcp": {
    "gamemaster-herald": {
      "type": "local",
      "command": ["/home/sujay/miniconda3/envs/dev/bin/python", "/home/sujay/Code/herald/main.py"],
      "enabled": true,
    },
    "context7": {
      "type": "remote",
